# Credenciais FAKE para testes E2E — NÃO usar em produção
# O Firebase SDK inicializa com esses valores mas todas as chamadas
# de rede são interceptadas pelo Playwright antes de chegar ao Google
VITE_FIREBASE_API_KEY=AIzaSyFAKE_TEST_KEY_FOR_E2E_ONLY_12345678
VITE_FIREBASE_AUTH_DOMAIN=poscomp-test.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=poscomp-test
VITE_FIREBASE_STORAGE_BUCKET=poscomp-test.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

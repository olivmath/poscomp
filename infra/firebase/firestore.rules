rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // questions: leitura autenticada, escrita só admin
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // users: próprio dono OU admin pode ler/escrever
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // announcements: leitura autenticada, escrita só admin
    match /announcements/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // flagged_questions: usuário autenticado reporta via Cloud Function (admin SDK bypassa regras)
    // leitura restrita ao próprio dono ou admin — evita exposição de uid/comment de outros usuários
    match /flagged_questions/{id} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow write: if isAdmin();
    }

    // premium_requests: criação exclusiva via Cloud Function (admin SDK bypassa regras)
    // cliente não tem permissão de escrita direta — evita injeção de receiptUrl arbitrária
    match /premium_requests/{requestId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow update: if isAdmin();
    }
  }
}
